#!/usr/bin/env bash
# Pre-commit gate for every tool, with or without agent hooks (Zed, Gemini CLI, Aider, a human):
# a commit lands only if ./ops/verify.sh passes on the working tree. Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! ./ops/verify.sh; then
  echo "pre-commit: ./ops/verify.sh failed; commit refused. Fix the failures, then commit again." >&2
  exit 1
fi
