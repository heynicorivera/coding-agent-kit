{
  "permissions": {
    "deny": [
      "Edit(ops/verify.sh)",
      "Edit(ops/check-agent-kit.sh)",
      "Edit(ops/agent/**)",
      "Edit(.claude/settings.json)",
      "Edit(.codex/**)",
      "Edit(.cursor/hooks.json)",
      "Edit(.github/hooks/**)",
      "Edit(.github/workflows/**)",
      "Edit(.githooks/**)",
      "Edit(~/.cache/agent-kit/**)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git config *core.hooksPath*)",
      "Bash(git -c *core.hooksPath*)",
      "Bash(rm *ops/*)",
      "Bash(mv *ops/*)",
      "Bash(chmod *ops/*)",
      "Bash(git rm *ops/*)",
      "Bash(git mv *ops/*)",
      "Bash(rm *.githooks*)",
      "Bash(chmod *.githooks*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/ops/agent/session-start.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)\"/ops/agent/stop_gate.py --consumer claude", "timeout": 330 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/ops/agent/session-end.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
